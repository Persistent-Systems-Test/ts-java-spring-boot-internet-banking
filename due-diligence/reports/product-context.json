      [
        "WF-01 Onboarding",
        [
          "Customer POST /user/api/v1/bank-users/register {email, identification, password}",
          "User svc: Keycloak search(email) -> reject if found",
          "User svc -> Core GET /api/v1/user/{identification}",
          "Email must equal core email",
          "Create disabled Keycloak user with password",
          "Persist local user status=PENDING",
          "Admin PATCH /update/{id} status=APPROVED -> Keycloak user enabled"
        ],
        [
          "E-28",
          "E-29"
        ]
      ],
      [
        "WF-02 Login",
        [
          "Client calls Keycloak token endpoint (password grant)",
          "Gateway validates JWT via JWKS on each call"
        ],
        [
          "E-10",
          "E-15"
        ]
      ],
      [
        "WF-03 Fund transfer",
        [
          "POST /fund-transfer/api/v1/transfer {fromAccount,toAccount,amount}",
          "Persist fund_transfer PENDING",
          "Feign -> Core POST /api/v1/transaction/fund-transfer",
          "Core validates balance, updates both accounts, writes 2 ledger rows",
          "Mark SUCCESS with core transactionId"
        ],
        [
          "E-18",
          "E-20",
          "E-33"
        ]
      ],
